  "purchase_intent_scoring": {
    "description": "Aggregate purchase intent score per video/account",
    "weights": {
      "purchase_inquiry": 3,
      "purchase_intent": 5,
      "product_discussion": 1,
      "positive_feedback": 0.5,
      "negative_feedback": -2,
      "social_engagement": 0.3,
      "other": 0
    },
    "interpretation": {
      "high": {"min_score": 2.0, "label": "High Purchase Intent", "label_zh": "高购买意向"},
      "medium": {"min_score": 1.0, "label": "Medium Purchase Intent", "label_zh": "中购买意向"},
      "low": {"min_score": 0, "label": "Low Purchase Intent", "label_zh": "低购买意向"}
    }
  },

  "sponsored_product_signals": {
    "description": "Signals that indicate a comment is about a sponsored/promoted product",
    "signals": [
      "link", "code", "discount", "promo", "buy",
      "bought", "order", "ordered", "product",
      "brand", "price", "how much", "where to buy",
